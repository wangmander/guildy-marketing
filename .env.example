# guildy-marketing environment

# Product app origin for the SERVER-SIDE proxy route (/api/quick-prep).
# Defaults to production; override for preview deploys pointed at a non-prod
# app host.
APP_ORIGIN=https://app.guildy.ai

# PostHog (client-side analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
