# guildy-marketing environment

# Product app origin for SERVER-SIDE proxy routes (/api/quick-prep,
# /api/share/create). Defaults to production; override for preview deploys
# pointed at a non-prod app host.
APP_ORIGIN=https://app.guildy.ai

# Product app origin for CLIENT-SIDE calls: the CORS-enabled share GET
# (/api/share/[id]) and the signup link (incl. the viral-loop &ref=).
# Public mirror of APP_ORIGIN; defaults to production.
NEXT_PUBLIC_APP_ORIGIN=https://app.guildy.ai

# PostHog (client-side analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
